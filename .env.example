# Copie para .env e ajuste. Todos os valores têm padrão sensato — este arquivo
# só é necessário para sair do padrão.

# ── Servidor ────────────────────────────────────────────────────────────
# Manter em 127.0.0.1. Mudar isto expõe documentos na rede, sem autenticação.
PDF2MD_HOST=127.0.0.1
PDF2MD_PORT=8000
PDF2MD_MAX_UPLOAD_MB=200
# Lote: teto de arquivos e de volume total por envio.
PDF2MD_MAX_BATCH_FILES=100
PDF2MD_MAX_BATCH_MB=1000

# ── Privacidade ─────────────────────────────────────────────────────────
PDF2MD_JOB_TTL_MINUTES=60
PDF2MD_KEEP_SOURCE_PDF=false
# PDF2MD_WORKSPACE_ROOT=D:\temp\pdf2md

# ── OCR ─────────────────────────────────────────────────────────────────
PDF2MD_OCR_ENABLED=true
PDF2MD_OCR_LANG=por
PDF2MD_OCR_DPI=300
PDF2MD_OCR_DESKEW=true
PDF2MD_OCR_BINARIZE=true
# PDF2MD_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ── Tabelas ─────────────────────────────────────────────────────────────
PDF2MD_TABLE_MIN_CONFIDENCE=0.65

# ── Saída ───────────────────────────────────────────────────────────────
# O .md leva o nome do PDF de origem. false volta ao fixo "documento.md".
PDF2MD_MD_USE_SOURCE_NAME=true

# ── Títulos ─────────────────────────────────────────────────────────────
PDF2MD_HEADING_SIZE_DELTA=0.75

# ── IA (desligada por padrão) ───────────────────────────────────────────
# claude_cli envia trechos do documento para fora da máquina.
PDF2MD_AI_ENABLED=false
PDF2MD_AI_PROVIDER=null
PDF2MD_AI_REQUIRE_CONSENT=true
# PDF2MD_AI_CLAUDE_CLI_PATH=
